# Semplice
/build/
/.qtcreator/
CMakeUserPresets.json
CMakeLists.txt.user*
/installer/

# release packages: the portable folder dist/Semplice is published, so the .exe / .dll rules above are lifted for it
!/dist/Semplice/**/*.exe
!/dist/Semplice/**/*.dll
# not published: the symbols for crash reports (about 200 MB, over the file limit of GitHub) and the zip copy of the folder
/dist/Semplice-symbols/
/dist/*.zip

# Not for the public repository: scratch files and working notes (moved here during the pre-release clean-up)
/.claude/
Programserr.txt

# Design sources (Figma exports, the UI document)
/docs/design/
/docs/source/
